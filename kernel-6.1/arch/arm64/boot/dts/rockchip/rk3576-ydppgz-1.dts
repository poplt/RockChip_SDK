/* this is a watchdog */
&wdt {
	status = "okay";
};

/* USB2 OTG0 */
&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	rockchip,typec-vbus-det;
	status = "okay";
};

/* PCIE0/SATA0 Combo PHY0 */
&combphy0_ps {
	status = "okay";
};

&pcie0 {
	reset-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
	// vpcie3v3-supply = <&vcc3v3_pcie0>;
	status = "okay";
};


/* PCIE1/SATA1/USB3_OTG1 Combo PHY1 */
&combphy1_psu {
	status = "okay";
};

&usb_drd1_dwc3 {
	dr_mode = "host";
	status = "okay";
	snps,parkmode-disable-hs-quirk;
	snps,parkmode-disable-ss-quirk;
	snps,dis_u3_susphy_quirk;
	snps,dis_u2_susphy_quirk;
};

&pinctrl {


	usb-typec {
		fusb302_int: fusb302-int {
			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		typec_vbus_en: typec-vbus-en {
			rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb-host {
		usb30_host_pwr_en: usb30-host-pwr-en {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		usb20_host_pwr_en: usb20-host-pwr-en {
			rockchip,pins = <0 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
