	status = "okay";
};

&pwm11 {
	status = "okay";
	pinctrl-names = "active";
	pinctrl-0 = <&pwm11m1_pins>;
};

&pwm13 {
	status = "okay";
};

&xin32k {
	status = "disabled";
};

